:root {
    --A-Color: #0b0d10;
    --B-Color: #15191d;
    --C-Color: #15191dbf;
    --Primary-A-Color: #39dbbf;
    --Primary-B-Color: #ffffff;
    --Primary-C-Color: #707488;
    --Primary-D-Color: #131922;
    --Primary-E-Color: #b4bec7;
    --Max-Size: 1150px;
}
/* ======  FONT */
@font-face { font-family: "Neo Sans Arabic"; font-style: normal; font-weight: 400; font-display: swap; src: local("Neo Sans Arabic"), url("/assets/font/Arabic.woff2") format("woff2"); }
/* ======  VIRTUAL */
* { margin: 0; padding: 0; text-decoration: none; list-style: none; list-style-type: none; font-weight: 500; font-family: "Neo Sans Arabic", Changa, Segoe UI, sans-serif; } a { color: var(--Primary-B-Color); }
html, body { background: var(--A-Color); color: var(--Primary-B-Color); overflow-x: hidden; width: 100%; margin: 0; padding: 0; }
